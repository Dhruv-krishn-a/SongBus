# Database
# SQLALCHEMY_DATABASE_URL="postgresql://postgres:password@localhost/playlistiq"
# For local MVP using SQLite:
SQLALCHEMY_DATABASE_URL="sqlite:///./playlistiq.db"

# Security
SECRET_KEY="your-super-secret-key-for-local-dev-only"

# Spotify API
SPOTIPY_CLIENT_ID="your_spotify_client_id"
SPOTIPY_CLIENT_SECRET="your_spotify_client_secret"
SPOTIPY_REDIRECT_URI="http://localhost:5173/callback"

# YouTube Music API (If using OAuth, otherwise handled via browser headers)
# YTMUSIC_OAUTH_CLIENT_ID=""
# YTMUSIC_OAUTH_CLIENT_SECRET=""
# For real YouTube Music liked songs and library playlists:
# create a browser auth json from https://music.youtube.com request headers
# and point this env var at that file.
# YTMUSIC_BROWSER_AUTH_PATH="/absolute/path/to/browser.json"
